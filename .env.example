# Neon PostgreSQL connection string (e.g. postgres://user:pass@host.neon.tech/db)
DATABASE_URL=

# Upstash Redis REST API credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Redis key prefix (defaults to 'test:' when NODE_ENV=test)
REDIS_KEY_PREFIX=

# TMDB API read access token used as the v4 Authorization Bearer header
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Strong random secret used to sign the user_session JWT cookie
JWT_SECRET=
